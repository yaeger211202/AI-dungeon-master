# Copy this file to .env and fill in your real key.
# .env should NEVER be committed to git.

GROQ_API_KEY=gsk_your_key_here

# Default model. You can also try:
#   llama-3.1-8b-instant       (fastest, good enough)
#   llama-3.3-70b-versatile    (slower but smarter — better for narrative)
GROQ_MODEL=llama-3.3-70b-versatile
